{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^wd-(.*)": "wot-design-uni/components/wd-$1/wd-$1.vue",
      "^uni-(.*)": "@dcloudio/uni-ui/lib/uni-$1/uni-$1.vue",
      "^y-(.*)": "@/uni_modules/y-$1/components/y-$1.vue"
    }
  },
  "pages": [
    {
      "path": "pages/login/login",
      "style": {
        "navigationStyle": "custom",
        "navigationBarTitleText": "登录"
      }
    },
    {
      "path": "pages/home/index",
      "style": {
        "navigationStyle": "custom",
        "navigationBarTitleText": "助手"
      }
    },
    {
      "path": "pages/assistant/chat",
      "style": {
        "navigationStyle": "custom",
        "navigationBarTitleText": "智能助手"
      }
    },
    {
      "path": "pages/conversation/index",
      "style": {
        "navigationStyle": "custom",
        "navigationBarTitleText": "我的会话"
      }
    },
    {
      "path": "pages/favorite/index",
      "style": {
        "navigationStyle": "custom",
        "navigationBarTitleText": "我的收藏"
      }
    },
    {
      "path": "pages/mine/mine",
      "style": {
        "navigationStyle": "custom",
        "navigationBarTitleText": "我的"
      }
    },
    {
      "path": "pages/settings/detail",
      "style": {
        "navigationStyle": "custom",
        "navigationBarTitleText": "设置"
      }
    }
  ],
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "NexoraOne",
    "navigationBarBackgroundColor": "#ffffff",
    "backgroundColor": "#f6f8fb"
  }
}
